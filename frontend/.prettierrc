{
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "arrowParens": "avoid",
    "printWidth": 100,
    "endOfLine": "auto",
    "bracketSameLine": false,
    "proseWrap": "preserve",
    "embeddedLanguageFormatting": "auto",
    "singleAttributePerLine": false
}
