# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/podx

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# Huddle01
HUDDLE01_API_KEY=your_huddle01_api_key_here
HUDDLE01_PROJECT_ID=your_huddle01_project_id_here

# Other services
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here

# Web3 Configuration
RPC_URL_ETHEREUM=your_ethereum_rpc_url_here
RPC_URL_POLYGON=your_polygon_rpc_url_here 